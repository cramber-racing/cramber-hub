{
	"name": "cramber",
	"version": "0.1.0",
	"description": "Cramber Hub - control app for Cramber sim-racing hardware",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"tauri": "tauri",
		"icon-gen": "tauri icon ./src-tauri/icons/icon.png",
		"format": "biome format --write"
	},
	"license": "UNLICENSED",
	"private": true,
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/lexend-zetta": "^5.3.0",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-autostart": "^2.7.0",
		"@tauri-apps/plugin-dialog": "^2.8.3",
		"@tauri-apps/plugin-opener": "^2",
		"@tauri-apps/plugin-store": "^2.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.65.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.0.16"
	}
}
