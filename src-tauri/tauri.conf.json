{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Cramber Hub",
	"version": "0.1.2",
	"identifier": "com.cramber.hub",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "Cramber Hub",
				"width": 1440,
				"height": 900,
				"minWidth": 1100,
				"minHeight": 720,
				"decorations": false,
				"backgroundColor": "#000000",
				"backgroundThrottling": "disabled",
				"visible": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"createUpdaterArtifacts": true,
		"windows": {
			"nsis": {
				"installMode": "perMachine",
				"installerIcon": "icons/icon.ico",
				"headerImage": "installer/header.bmp",
				"sidebarImage": "installer/sidebar.bmp"
			}
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0N0ZCNkYwNTA1NjQ2RTAKUldUZ1JsWlE4TFovZEdJTVR0bGxOQ1lxVUtpWi9SK0xxWGxCczVWRUF6cjJaTkxmWHB3M2srYlkK",
			"endpoints": ["https://github.com/cramber-racing/cramber-hub/releases/latest/download/latest.json"],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
